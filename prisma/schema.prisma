generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users, addresses and authentication
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum Province {
  MAPUTO_CIDADE
  MAPUTO_PROVINCIA
  GAZA
  INHAMBANE
  SOFALA
  MANICA
  TETE
  ZAMBEZIA
  NAMPULA
  CABO_DELGADO
  NIASSA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  company      String?
  taxId        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  province      Province
  city          String
  neighborhood  String
  street        String
  reference     String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog: categories, brands, machine models
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  imageUrl    String?
  position    Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryToSubcategory")
  products    Product[]

  @@index([parentId])
}

enum EquipmentType {
  ESCAVADORA
  RETROESCAVADORA
  PA_CARREGADORA
  TRATOR
  MOTONIVELADORA
  BULLDOZER
  EMPILHADORA
  DUMPER
  GRUA
  COMPACTADOR
  GERADOR
}

model Brand {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  origin String?

  machineModels MachineModel[]
}

model MachineModel {
  id       String        @id @default(cuid())
  brandId  String
  brand    Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  type     EquipmentType
  yearFrom Int?
  yearTo   Int?

  compatibleProducts ProductCompatibility[]

  @@unique([brandId, name])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Products (parts)
// ---------------------------------------------------------------------------

enum ProductCondition {
  NOVO
  RECONDICIONADO
  USADO
}

model Product {
  id                    String           @id @default(cuid())
  sku                   String           @unique
  name                  String
  slug                  String           @unique
  shortDescription      String
  description           String
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  price                 Decimal          @db.Decimal(12, 2)
  compareAtPrice        Decimal?         @db.Decimal(12, 2)
  currency              String           @default("MZN")
  condition             ProductCondition @default(NOVO)
  oemNumber             String?
  crossReferenceNumbers String[]         @default([])
  stockQuantity         Int              @default(0)
  weightKg              Decimal?         @db.Decimal(10, 2)
  warrantyMonths        Int              @default(0)
  isFeatured            Boolean          @default(false)
  isActive              Boolean          @default(true)
  averageRating         Decimal          @default(0) @db.Decimal(2, 1)
  reviewCount           Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  images        ProductImage[]
  specs         ProductSpec[]
  compatibility ProductCompatibility[]
  reviews       Review[]
  wishlistedBy  WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int     @default(0)

  @@index([productId])
}

model ProductCompatibility {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  machineModelId String
  machineModel   MachineModel @relation(fields: [machineModelId], references: [id], onDelete: Cascade)

  @@unique([productId, machineModelId])
  @@index([machineModelId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  title      String
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDENTE
  CONFIRMADA
  EM_PROCESSAMENTO
  ENVIADA
  ENTREGUE
  CANCELADA
}

enum PaymentMethod {
  TRANSFERENCIA_BANCARIA
  MPESA
  EMOLA
  NUMERARIO_NA_ENTREGA
}

enum PaymentStatus {
  PENDENTE
  PAGO
  FALHOU
  REEMBOLSADO
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDENTE)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDENTE)

  customerName  String
  customerEmail String
  customerPhone String
  province      Province
  city          String
  neighborhood  String
  street        String
  reference     String?
  notes         String?

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  currency     String  @default("MZN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Content & marketing
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String
  content       String
  coverImageUrl String
  author        String
  publishedAt   DateTime @default(now())
}

model HeroSlide {
  id                String  @id @default(cuid())
  headlineMain      String
  headlineHighlight String
  description       String
  ctaLabel          String
  ctaHref           String
  photoUrl          String
  photoAlt          String
  photoCompact      Boolean @default(false)
  position          Int     @default(0)
  isActive          Boolean @default(true)
}

model PromoBanner {
  id          String  @id @default(cuid())
  title       String
  badge       String
  description String
  href        String
  icon        String
  gradient    String
  position    Int     @default(0)
  isActive    Boolean @default(true)
}

model PartnerLogo {
  id        String  @id @default(cuid())
  name      String
  imageUrl  String
  position  Int     @default(0)
  isActive  Boolean @default(true)
}

model BusinessQuestionnaireResponse {
  id             String   @id @default(cuid())
  respondentName String
  respondentRole String?
  answers        Json
  submittedAt    DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("singleton")
  companyName    String
  phonePrimary   String
  phoneSecondary String
  whatsapp       String
  email          String
  address        String
  hours          String
  updatedAt      DateTime @updatedAt
}

// Flat {fieldKey: value} overrides for the equipment rental / labor services
// price table (admin/precos). Field keys are stable strings defined in
// src/lib/pricing-data.ts; anything not present there falls back to the
// printed original value, so the table works before any edit is ever saved.
model PricingTable {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

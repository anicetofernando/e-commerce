DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/albimaq"
SESSION_SECRET="change-this-to-a-long-random-string-in-production"
# The local PGlite dev database only supports one connection at a time.
# Omit this (or set higher) when DATABASE_URL points to a real Postgres server.
PG_POOL_MAX=1

# Cloudinary (admin image uploads) — from your Cloudinary dashboard, no card required.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (transactional emails: order confirmation, contact form, password
# reset) — from resend.com/api-keys. Emails are skipped (logged only) when
# this is left empty, so local dev works without it. Customer replies always
# go to info@albimaq.co.mz (set as Reply-To in src/lib/email.ts), regardless
# of the sending address below.
RESEND_API_KEY=""
EMAIL_FROM=""

# Public base URL used to build links inside emails (e.g. password reset)
# and Stripe checkout redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (international card payments) — from dashboard.stripe.com/apikeys.
# The "Cartão Internacional" checkout option is hidden with an error message
# when STRIPE_SECRET_KEY is empty. STRIPE_WEBHOOK_SECRET comes from the
# webhook endpoint you register for https://<your-domain>/api/webhooks/stripe
# (dashboard.stripe.com/webhooks); without it, paid orders never get marked
# as PAGO. Stripe does not settle in MZN — the order total is converted to
# USD using the exchange rate set in Admin > Definições.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
